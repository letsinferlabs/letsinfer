{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letsinfer.ai/schemas/benchmark/li_benchmark_record_v8.schema.json",
  "title": "Let's Infer native execution-payload benchmark record schema 8",
  "$comment": "Canonical hashes, timestamp derivation, result identity, telemetry maxima, TTFT arithmetic, and benchmark ID are additionally enforced by benchmarks.benchmark_record.validate_record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "installation_id", "timestamp", "timestamp_unix_ns", "subject", "benchmark_contract_sha256", "results_sha256", "results", "benchmark_contract"],
  "properties": {
    "schema_version": {"const": 8},
    "id": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/sha256"},
    "installation_id": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/sha256"},
    "timestamp": {"type": "integer", "minimum": 1},
    "timestamp_unix_ns": {"type": "integer", "minimum": 1},
    "subject": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/native_subject_v8"},
    "benchmark_contract_sha256": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/sha256"},
    "results_sha256": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/sha256"},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/result_v1"}},
    "benchmark_contract": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/contract_v8"},
    "ttft_cache": {"$ref": "li_benchmark_common_v1.schema.json#/$defs/ttft_cache_result_v1"}
  }
}
