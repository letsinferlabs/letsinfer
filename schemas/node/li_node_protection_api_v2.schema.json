{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letsinfer.ai/schemas/node/li_node_protection_api_v2.schema.json",
  "title": "Let's Infer Node protection API v2",
  "oneOf": [
    { "$ref": "#/$defs/request_envelope" },
    { "$ref": "#/$defs/response_envelope" }
  ],
  "$defs": {
    "schema_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "li_node_protection_api" },
        "version": { "const": 2 }
      }
    },
    "hex_32": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "hex_64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positive_integer": { "type": "integer", "minimum": 1 },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "request_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "connection_id", "request"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_identity" },
        "request_id": { "$ref": "#/$defs/hex_64" },
        "connection_id": { "$ref": "#/$defs/hex_64" },
        "request": { "$ref": "#/$defs/request" }
      }
    },
    "request": {
      "oneOf": [
        { "$ref": "#/$defs/begin_request" },
        { "$ref": "#/$defs/commit_request" },
        { "$ref": "#/$defs/end_request" },
        { "$ref": "#/$defs/controller_binding_request" },
        { "$ref": "#/$defs/site_status_request" },
        { "$ref": "#/$defs/snapshot_request" }
      ]
    },
    "begin_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "begin_watchdog_session" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idempotency_key",
            "node_id",
            "core_installation_id",
            "watchdog_source_identity",
            "watchdog_session_nonce",
            "minimum_sample_sequence"
          ],
          "properties": {
            "idempotency_key": { "$ref": "#/$defs/idempotency_key" },
            "node_id": { "$ref": "#/$defs/hex_32" },
            "core_installation_id": { "$ref": "#/$defs/hex_64" },
            "watchdog_source_identity": { "$ref": "#/$defs/hex_64" },
            "watchdog_session_nonce": { "$ref": "#/$defs/hex_64" },
            "minimum_sample_sequence": { "$ref": "#/$defs/positive_integer" }
          }
        }
      }
    },
    "commit_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "commit_watchdog_cycle" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "watchdog_session_id",
            "watchdog_session_generation",
            "cycle"
          ],
          "properties": {
            "node_id": { "$ref": "#/$defs/hex_32" },
            "watchdog_session_id": { "$ref": "#/$defs/hex_64" },
            "watchdog_session_generation": { "$ref": "#/$defs/positive_integer" },
            "cycle": { "$ref": "#/$defs/completed_cycle" }
          }
        }
      }
    },
    "completed_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_sequence",
        "observed_at_unix_milliseconds",
        "observed_at_monotonic_milliseconds",
        "protected_descriptors"
      ],
      "properties": {
        "sample_sequence": { "$ref": "#/$defs/positive_integer" },
        "observed_at_unix_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "observed_at_monotonic_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "protected_descriptors": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "end_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "end_watchdog_session" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "watchdog_session_id", "watchdog_session_generation"],
          "properties": {
            "node_id": { "$ref": "#/$defs/hex_32" },
            "watchdog_session_id": { "$ref": "#/$defs/hex_64" },
            "watchdog_session_generation": { "$ref": "#/$defs/positive_integer" }
          }
        }
      }
    },
    "controller_binding_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "resolve_controller_binding" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["certificate_sha256"],
          "properties": {
            "certificate_sha256": { "$ref": "#/$defs/hex_64" }
          }
        }
      }
    },
    "site_status_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "read_site_status" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding"],
          "properties": {
            "binding": { "$ref": "#/$defs/controller_binding" }
          }
        }
      }
    },
    "snapshot_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "read_gateway_snapshot" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "placement_group_id", "endpoint_node_id"],
          "properties": {
            "node_id": { "$ref": "#/$defs/hex_32" },
            "placement_group_id": { "$ref": "#/$defs/hex_32" },
            "endpoint_node_id": { "$ref": "#/$defs/hex_32" }
          }
        }
      }
    },
    "response_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "connection_id", "sequence", "outcome"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_identity" },
        "request_id": { "$ref": "#/$defs/hex_64" },
        "connection_id": { "$ref": "#/$defs/hex_64" },
        "sequence": { "$ref": "#/$defs/positive_integer" },
        "outcome": {
          "oneOf": [
            { "$ref": "#/$defs/success_outcome" },
            { "$ref": "#/$defs/failure_outcome" }
          ]
        }
      }
    },
    "success_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "body"],
      "properties": {
        "status": { "const": "success" },
        "body": { "$ref": "#/$defs/success_body" }
      }
    },
    "failure_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "body"],
      "properties": {
        "status": { "const": "failure" },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "enum": [
                "authorization_denied",
                "invalid_contract",
                "conflict",
                "corrupt",
                "provider_unavailable"
              ]
            }
          }
        }
      }
    },
    "success_body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "value"],
          "properties": {
            "result": { "const": "watchdog_session_began" },
            "value": { "$ref": "#/$defs/authority" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "value"],
          "properties": {
            "result": { "const": "watchdog_cycle_committed" },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lease_count"],
              "properties": {
                "lease_count": { "type": "integer", "minimum": 0, "maximum": 1024 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result"],
          "properties": { "result": { "const": "watchdog_session_ended" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "value"],
          "properties": {
            "result": { "const": "controller_binding" },
            "value": { "$ref": "#/$defs/controller_binding" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "value"],
          "properties": {
            "result": { "const": "site_status" },
            "value": { "$ref": "#/$defs/site_status" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "value"],
          "properties": {
            "result": { "const": "gateway_snapshot" },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshot"],
              "properties": {
                "snapshot": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "#/$defs/snapshot" }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "controller_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_id",
        "certificate_sha256",
        "session_generation",
        "protected_descriptor"
      ],
      "properties": {
        "controller_id": { "$ref": "#/$defs/hex_32" },
        "certificate_sha256": { "$ref": "#/$defs/hex_64" },
        "session_generation": { "$ref": "#/$defs/positive_integer" },
        "protected_descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "status_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127,
      "pattern": "^[A-Za-z0-9._:/@+\\-]+$"
    },
    "site_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "model",
        "engine",
        "runtime_name",
        "runtime_version",
        "manifest_sha256",
        "cache_provider",
        "cache_persistent",
        "inference_port",
        "maximum_connections",
        "maximum_active_requests",
        "maximum_context_tokens",
        "service_state",
        "engine_state",
        "protection_phase",
        "protection_armed",
        "trip_latched",
        "container_name",
        "installation_id"
      ],
      "properties": {
        "release": { "$ref": "#/$defs/status_text" },
        "model": { "$ref": "#/$defs/status_text" },
        "engine": { "$ref": "#/$defs/status_text" },
        "runtime_name": { "$ref": "#/$defs/status_text" },
        "runtime_version": { "$ref": "#/$defs/status_text" },
        "manifest_sha256": { "$ref": "#/$defs/hex_64" },
        "cache_provider": { "$ref": "#/$defs/status_text" },
        "cache_persistent": { "type": "boolean" },
        "inference_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "maximum_connections": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "maximum_active_requests": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "maximum_context_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "service_state": { "$ref": "#/$defs/status_text" },
        "engine_state": { "$ref": "#/$defs/status_text" },
        "protection_phase": { "$ref": "#/$defs/status_text" },
        "protection_armed": { "type": "boolean" },
        "trip_latched": { "type": "boolean" },
        "container_name": {
          "type": "string",
          "maxLength": 127,
          "pattern": "^(?:[A-Za-z0-9._:/@+\\-]+)?$"
        },
        "installation_id": { "$ref": "#/$defs/hex_64" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "core_installation_id",
        "watchdog_source_identity",
        "watchdog_session_id",
        "watchdog_session_generation"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/hex_32" },
        "core_installation_id": { "$ref": "#/$defs/hex_64" },
        "watchdog_source_identity": { "$ref": "#/$defs/hex_64" },
        "watchdog_session_id": { "$ref": "#/$defs/hex_64" },
        "watchdog_session_generation": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement_group_id", "expected_placements", "authorities", "leases"],
      "properties": {
        "placement_group_id": { "$ref": "#/$defs/hex_32" },
        "expected_placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/expected_placement" }
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/authority" }
        },
        "leases": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/lease" }
        }
      }
    },
    "expected_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement_id", "node_id"],
      "properties": {
        "placement_id": { "$ref": "#/$defs/hex_32" },
        "node_id": { "$ref": "#/$defs/hex_32" }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "placement_group_id",
        "placement_id",
        "core_installation_id",
        "watchdog_source_identity",
        "watchdog_session_id",
        "watchdog_session_generation",
        "protection_generation",
        "container_name",
        "container_id",
        "process_id",
        "process_start_ticks",
        "boot_id",
        "cgroup",
        "sample_sequence",
        "observed_at_unix_milliseconds",
        "observed_at_monotonic_milliseconds",
        "expires_at_unix_milliseconds",
        "armed",
        "trip_latched"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/hex_32" },
        "placement_group_id": { "$ref": "#/$defs/hex_32" },
        "placement_id": { "$ref": "#/$defs/hex_32" },
        "core_installation_id": { "$ref": "#/$defs/hex_64" },
        "watchdog_source_identity": { "$ref": "#/$defs/hex_64" },
        "watchdog_session_id": { "$ref": "#/$defs/hex_64" },
        "watchdog_session_generation": { "$ref": "#/$defs/positive_integer" },
        "protection_generation": { "$ref": "#/$defs/hex_32" },
        "container_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "container_id": { "$ref": "#/$defs/hex_64" },
        "process_id": { "type": "integer", "minimum": 2, "maximum": 4294967295 },
        "process_start_ticks": { "$ref": "#/$defs/positive_integer" },
        "boot_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" },
        "cgroup": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4095,
          "pattern": "^/sys/fs/cgroup/(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\s)(?!.*=).+[^/]$"
        },
        "sample_sequence": { "$ref": "#/$defs/positive_integer" },
        "observed_at_unix_milliseconds": { "type": "integer", "minimum": 0 },
        "observed_at_monotonic_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "expires_at_unix_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "armed": { "type": "boolean" },
        "trip_latched": { "type": "boolean" }
      }
    }
  }
}
