#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
set -euo pipefail
if [[ -z ${LETSINFER_HOME:-} ]]; then
    LETSINFER_HOME=$HOME/.local/share/letsinfer
    export LETSINFER_HOME_DEFAULTED=1
fi
export LETSINFER_HOME
LETSINFER_LAUNCHER_DIR=$(CDPATH= cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export LETSINFER_LAUNCHER_DIR
SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
    LINK_TARGET=$(readlink "$SCRIPT_PATH")
    case "$LINK_TARGET" in
        /*) SCRIPT_PATH=$LINK_TARGET ;;
        *) SCRIPT_PATH=$SCRIPT_DIR/$LINK_TARGET ;;
    esac
done
SCRIPT_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -P -- "${SCRIPT_DIR}/.." && pwd)
export PYTHONDONTWRITEBYTECODE=1
PYTHON_COMMAND=${LETSINFER_PYTHON:-}
if [[ -z "$PYTHON_COMMAND" && -x "$LETSINFER_HOME/core/python" ]]; then
    PYTHON_COMMAND=$LETSINFER_HOME/core/python
fi
if [[ -z "$PYTHON_COMMAND" ]]; then
    PYTHON_COMMAND=python3
fi
export LETSINFER_PYTHON=$PYTHON_COMMAND
exec "$PYTHON_COMMAND" -I -B -c '
import runpy
import sys

sys.path.insert(0, sys.argv.pop(1))
runpy.run_module("core.cli", run_name="__main__")
' "$PROJECT_ROOT" "$@"
